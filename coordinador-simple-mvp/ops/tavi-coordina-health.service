[Unit]
Description=Health audit for TAVI Coordina production
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/tavi-coordina-health
TimeoutStartSec=2min
StateDirectory=tavi-coordina-monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
