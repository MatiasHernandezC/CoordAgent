# Caddy sirve el frontend y proxya /api al backend en el mismo dominio.
# TLS automatico con Let's Encrypt cuando PUBLIC_DOMAIN es un dominio real.
# Para pruebas locales sin dominio, PUBLIC_DOMAIN=localhost usa http en :80.

{$PUBLIC_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Sin Basic Auth: Slack no puede mandar esas credenciales. Se valida con
	# su firma HMAC (X-Slack-Signature) dentro del backend.
	handle /api/channels/slack/events {
		reverse_proxy backend:8000
	}

	# Clicks de los botones de Block Kit (Interactivity & Shortcuts). Misma
	# proteccion que /events: firma HMAC, no Basic Auth.
	handle /api/channels/slack/interactions {
		reverse_proxy backend:8000
	}

	# El backend monta sus rutas bajo /api y expone /health.
	# Hasta 5 admins (1 obligatorio + 4 opcionales). Los slots sin usar quedan
	# con un usuario/hash inertes (ver docker-compose.prod.yml) porque Caddy
	# no acepta una linea de basic_auth con usuario o hash vacio.
	handle /api/* {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
			{$BASIC_AUTH_USER_2} {$BASIC_AUTH_HASH_2}
			{$BASIC_AUTH_USER_3} {$BASIC_AUTH_HASH_3}
			{$BASIC_AUTH_USER_4} {$BASIC_AUTH_HASH_4}
			{$BASIC_AUTH_USER_5} {$BASIC_AUTH_HASH_5}
		}
		reverse_proxy backend:8000 {
			# Caddy sobrescribe este header despues de validar Basic Auth. El
			# backend lo usa como X-Coordina-Admin: identidad del admin para
			# auditoria y para filtrar que grupos puede ver/administrar.
			header_up X-Coordina-Admin {http.auth.user.id}
		}
	}
	handle /health {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
			{$BASIC_AUTH_USER_2} {$BASIC_AUTH_HASH_2}
			{$BASIC_AUTH_USER_3} {$BASIC_AUTH_HASH_3}
			{$BASIC_AUTH_USER_4} {$BASIC_AUTH_HASH_4}
			{$BASIC_AUTH_USER_5} {$BASIC_AUTH_HASH_5}
		}
		reverse_proxy backend:8000
	}

	# Todo lo demas es el frontend estatico (nginx).
	handle {
		reverse_proxy frontend:80
	}
}
