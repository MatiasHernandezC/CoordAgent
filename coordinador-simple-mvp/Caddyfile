# Caddy sirve el frontend y proxya /api al backend en el mismo dominio.
# TLS automatico con Let's Encrypt cuando PUBLIC_DOMAIN es un dominio real.
# Para pruebas locales sin dominio, PUBLIC_DOMAIN=localhost usa http en :80.

{$CADDY_SITE_ADDRESS::80} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Slack se valida con su firma HMAC (X-Slack-Signature) dentro del backend.
	handle /api/channels/slack/events {
		reverse_proxy backend:8000
	}

	# El backend monta sus rutas bajo /api y expone /health.
	handle /api/* {
		# El backend valida cada cuenta y su rol. Esto permite varios usuarios
		# sin exponer tokens ni configuracion administrativa.
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# Todo lo demas es el frontend estatico (nginx).
	handle {
		reverse_proxy frontend:80
	}
}
