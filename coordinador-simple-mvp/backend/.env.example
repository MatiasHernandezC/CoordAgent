APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_FILE=data/sessions.json
USERS_FILE=data/users.json
PANEL_AUTH_REQUIRED=false
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=
PANEL_SELF_REGISTRATION_ENABLED=true
# Solo para una demo local aislada; nunca lo actives al publicar un tunel.
PANEL_SEED_DEMO_USERS=false
GATEWAY_API_TOKEN=

# Copia este archivo como backend/.env.
# Despues de cambiarlo, reinicia FastAPI.
#
# local = usa local_llm.py con Qwen por defecto.
# gemini = usa API de Gemini.
# mock = extractor por reglas para desarrollo rapido.
# ollama = usa Ollama local.
#
# Valores validos: mock | local | gemini | ollama.
LLM_PROVIDER=local

LOCAL_LLM_MODEL=qwen
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_TOKENS=700
LLM_CACHE_ENABLED=true
LLM_CACHE_MAX_ITEMS=64
# true = si el LLM falla, usa mock para que la demo no muera.
# false = obliga a usar Qwen local y muestra error si falla.
LLM_FALLBACK_ENABLED=false
# LOCAL_LLM_PYTHON=<RUTA_PROYECTO>\.venv\Scripts\python.exe
# LOCAL_LLM_SCRIPT=<RUTA_PROYECTO>\local_llm.py

# Gemini: usa un modelo disponible para generateContent.
# gemini-3.0-flash no es valido para el endpoint v1beta actual.
GEMINI_API_KEY=
LLM_KEYS_MASTER_KEY=
LLM_KEYS_FILE=data/llm_keys.json
ADMIN_PROXY_HEADER_REQUIRED=false
GEMINI_MODEL=gemini-2.5-flash-lite
# Si generateContent del principal devuelve 404 (p. ej. llaves "new users"),
# se reintenta con este modelo en la misma llave.
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest
GEMINI_STREAMING_ENABLED=true
GEMINI_TIMEOUT_SECONDS=45
GEMINI_COOLDOWN_SECONDS=60
GEMINI_INPUT_PRICE_PER_MILLION=0.10
GEMINI_OUTPUT_PRICE_PER_MILLION=0.40
# GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1

# Base de datos PostgreSQL.
# Reemplaza user, password, y meetingdb con tus credenciales reales.
# Ejemplo local:   postgresql://postgres:1234@localhost:5432/meetingdb
# Ejemplo Docker:  postgresql://user:password@db:5432/meetingdb
DATABASE_URL=postgresql://user:password@localhost:5432/meetingdb

# Canal Slack (opcional, ademas de WhatsApp). Ver docs/DESPLIEGUE_SLACK.md.
# Sin SLACK_BOT_TOKEN/SLACK_SIGNING_SECRET el endpoint responde 503.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TRIGGER_WORD=@coordina

# Google Calendar (opcional): OAuth a nivel administrador para crear el
# evento real al confirmar. Ver docs/CONFIGURACION_GOOGLE_CALENDAR.md.
# Sin estas tres variables el panel muestra la integracion como "no configurada"
# y el flujo sigue usando el link + .ics como hasta ahora.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/admin/google-calendar/callback
