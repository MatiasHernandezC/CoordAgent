# Caddy SOLO para probar en local la diferenciacion de admins (owner_admin).
# No se usa en produccion (ver Caddyfile) ni reemplaza el flujo directo de
# desarrollo (:5173 / :8000, sin Basic Auth). Sirve la build de frontend
# armada con VITE_API_URL apuntando a este mismo origen, para que las
# llamadas /api queden en el mismo origen que Basic Auth protege.

:80 {
	handle /api/channels/slack/events {
		reverse_proxy backend:8000
	}
	handle /api/channels/slack/interactions {
		reverse_proxy backend:8000
	}
	handle /api/* {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
			{$BASIC_AUTH_USER_2} {$BASIC_AUTH_HASH_2}
		}
		reverse_proxy backend:8000 {
			header_up X-Coordina-Admin {http.auth.user.id}
		}
	}
	handle /health {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
			{$BASIC_AUTH_USER_2} {$BASIC_AUTH_HASH_2}
		}
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend-caddy-test:80
	}
}
