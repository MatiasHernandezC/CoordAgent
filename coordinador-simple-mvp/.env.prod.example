# Copia este archivo como .env.prod y complétalo. NO lo subas al repo.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── Dominio y URL publica ───────────────────────────────────────────────────
# Dominio real -> Caddy saca certificado TLS solo. Para pruebas: localhost
PUBLIC_DOMAIN=coordina.tudominio.com
# URL con esquema, la misma que ve el navegador (para el build del frontend y CORS)
PUBLIC_URL=https://coordina.tudominio.com

# ── Base de datos ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_por_una_fuerte
POSTGRES_DB=meetingdb

# ── LLM ─────────────────────────────────────────────────────────────────────
# gemini = IA real en la nube (recomendado en el droplet). mock = reglas sin IA.
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash-lite

# ── WhatsApp gateway ────────────────────────────────────────────────────────
TRIGGER_WORD=@coordina
LOG_LEVEL=info
