# Copia este archivo como .env.prod y completalo.
# NO subas .env.prod al repo.
#
# Uso:
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Dominio publico
# Caddy usa PUBLIC_DOMAIN para TLS automatico. PUBLIC_URL se usa en el build del
# frontend y para CORS del backend.
PUBLIC_DOMAIN=coordina.tudominio.com
PUBLIC_URL=https://coordina.tudominio.com

# Login HTTP Basic para /api/* y /health.
# Genera el hash con:
# docker run --rm caddy:2 caddy hash-password --plaintext "tu_password"
BASIC_AUTH_USER=coordina
BASIC_AUTH_HASH='$2a$14$reemplaza_este_hash_bcrypt_generado_por_caddy'

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_por_una_fuerte
POSTGRES_DB=meetingdb

# LLM
# gemini = IA real en la nube (recomendado en el droplet).
# mock = reglas sin IA para pruebas sin costo.
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_de_gemini
LLM_KEYS_MASTER_KEY=genera_32_bytes_en_base64_y_no_la_compartas
ADMIN_PROXY_HEADER_REQUIRED=true
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest
GEMINI_STREAMING_ENABLED=true
GEMINI_COOLDOWN_SECONDS=60

# Fallback recomendado para demos: si Gemini falla, usa reglas y no rompe el flujo.
LLM_FALLBACK_ENABLED=true
LLM_CACHE_ENABLED=true

# Precios aproximados para mostrar costo estimado en runtime/respuestas.
GEMINI_INPUT_PRICE_PER_MILLION=0.10
GEMINI_OUTPUT_PRICE_PER_MILLION=0.40

# Zona horaria para interpretar "hoy" y para el evento .ics del calendario.
APP_TIMEZONE=America/Santiago

# WhatsApp gateway
TRIGGER_WORD=@coordina
LOG_LEVEL=info
BOT_PHONE_NUMBER=+56 9 3527 1985

# Canal Slack (opcional, ademas de WhatsApp). Ver docs/DESPLIEGUE_SLACK.md.
# Sin estas dos variables el endpoint /api/channels/slack/events responde 503
# y el resto de la app sigue funcionando igual.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TRIGGER_WORD=@coordina

# Google Calendar (opcional): OAuth a nivel administrador para crear el evento
# real al confirmar, ademas del link y el .ics que ya se envian siempre.
# Ver docs/CONFIGURACION_GOOGLE_CALENDAR.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://coordina.tudominio.com/api/admin/google-calendar/callback

# Tuning opcional del gateway (defaults razonables; ver docs/DESPLIEGUE_WHATSAPP.md)
# Debe superar GEMINI_TIMEOUT_SECONDS (45s) mas render/envio.
# API_TIMEOUT_MS=75000
# WA_CONNECT_TIMEOUT_MS=60000
# WA_KEEP_ALIVE_MS=30000
# WA_RECONNECT_MIN_MS=2000
# WA_RECONNECT_MAX_MS=60000
# WA_GROUP_SYNC_INTERVAL_MS=300000
# WA_FIRE_INIT_QUERIES=false
# GATEWAY_HEARTBEAT_INTERVAL_MS=600000
# MAX_PENDING_MESSAGES=500
# PENDING_RETRY_MIN_MS=2000
# PENDING_RETRY_MAX_MS=300000
# MAX_PENDING_ATTEMPTS=12
# RECENT_MESSAGE_LIMIT=500
