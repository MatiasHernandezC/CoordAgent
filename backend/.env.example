APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_FILE=data/sessions.json

# Copia este archivo como backend/.env.
# Despues de cambiarlo, reinicia FastAPI.
#
# local = usa local_llm.py con Qwen por defecto.
# gemini = usa API de Gemini.
# mock = extractor por reglas para desarrollo rapido.
# ollama = usa Ollama local.
#
# Valores validos: mock | local | gemini | ollama.
LLM_PROVIDER=local

LOCAL_LLM_MODEL=qwen
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_TOKENS=700
LLM_CACHE_ENABLED=true
LLM_CACHE_MAX_ITEMS=64
# true = si el LLM falla, usa mock para que la demo no muera.
# false = obliga a usar Qwen local y muestra error si falla.
LLM_FALLBACK_ENABLED=false
# LOCAL_LLM_PYTHON=C:\Users\cocan\Downloads\(Ultimos ramos)\TAVI\.venv\Scripts\python.exe
# LOCAL_LLM_SCRIPT=C:\Users\cocan\Downloads\(Ultimos ramos)\TAVI\local_llm.py

# Gemini: usa un modelo disponible para generateContent.
# gemini-3.0-flash no es valido para el endpoint v1beta actual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
GEMINI_COOLDOWN_SECONDS=60
GEMINI_INPUT_PRICE_PER_MILLION=0.10
GEMINI_OUTPUT_PRICE_PER_MILLION=0.40
# GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1

# Base de datos PostgreSQL.
# Reemplaza user, password, y meetingdb con tus credenciales reales.
# Ejemplo local:   postgresql://postgres:1234@localhost:5432/meetingdb
# Ejemplo Docker:  postgresql://user:password@db:5432/meetingdb
DATABASE_URL=postgresql://user:password@localhost:5432/meetingdb